# Copy to .env and fill in. .env is gitignored. The same names serve the Mac and a host; what a host
# sets differently is in docs/ops/HOST.md. This file holds names and never a value: the repo is public.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Every name the dashboard is reached under. On a host, and on a machine another one pulls a copy from: its private name too.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Jerusalem

# --- Database (Postgres in Docker; host port 5435 — 5432 organism, 5433 investment engine, 5434 conflict map) ---
DB_HOST=localhost
DB_PORT=5435
DB_NAME=golaiet
DB_USER=golaiet
DB_PASSWORD=

# --- Telegram (the same bot as the investment engine; both values required, their presence is the switch) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://api.telegram.org   (the e2e stack points this at its fake)
TELEGRAM_CHAT_ID=

# --- Claude headless agent ---
CLAUDE_BIN=claude
# Plan quota: run `claude setup-token` on the host (active Pro/Max subscription; the token lives ~1 year)
# and paste the sk-ant-oat… value. The scheduler entrypoint drops ANTHROPIC_API_KEY when this is set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# CLI alias ("sonnet", "opus") or full id. Always passed explicitly so sessions never ride a host default.
CLAUDE_MODEL=sonnet
# The Telegram conversation's model; empty means CLAUDE_MODEL.
# CLAUDE_REPLY_MODEL=opus

# The Obsidian vault: add_note appends to a lane's file under it. Host runs read VAULT_DIR;
# compose mounts VAULT_HOST_DIR into the scheduler at /vault.
# VAULT_DIR=
# VAULT_HOST_DIR=
AGENT_TIMEOUT_SEC=900

# --- Backups ---
# The folder on this machine that the nightly dump and backup_db write to; compose mounts it into the
# scheduler at /backups. Unset: ~/Backups/golaiet. Keep it outside this working copy.
# BACKUP_HOST_DIR=

# --- Copying the database to another machine ---
# A secret of 32 characters or more, the same on both machines. Set, this side hands its whole database
# to a caller that sends it (GET /api/dump), and `pull_db <address>` sends it to the other side.
# Unset: no dump is served and none is pulled from an address.
# DUMP_TOKEN=

# --- Knowing that the stack is down ---
# The address of an outside service that expects a call every half hour and alerts when the calls stop.
# The heartbeat calls it when set. Treat it as a secret: whoever has it can keep the alarm quiet.
# HEARTBEAT_PING_URL=

# --- Deploying to the host (./deploy.sh, on the Mac only) ---
# The host's SSH alias, the folder of the working copy there, and the address this Mac reaches its
# dashboard at for the smoke test. The repo is public: the values live here and nowhere in it.
# DEPLOY_SSH=
# DEPLOY_DIR=
# DEPLOY_URL=
