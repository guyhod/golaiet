# Copy to .env and fill in. .env is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Jerusalem

# --- Database (Postgres in Docker; host port 5435 — 5432 organism, 5433 investment engine, 5434 conflict map) ---
DB_HOST=localhost
DB_PORT=5435
DB_NAME=golaiet
DB_USER=golaiet
DB_PASSWORD=

# --- Telegram (the same bot as the investment engine; both values required, their presence is the switch) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude headless agent ---
CLAUDE_BIN=claude
# Plan quota: run `claude setup-token` on the host (active Pro/Max subscription; the token lives ~1 year)
# and paste the sk-ant-oat… value. The scheduler entrypoint drops ANTHROPIC_API_KEY when this is set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# CLI alias ("sonnet", "opus") or full id. Always passed explicitly so sessions never ride a host default.
CLAUDE_MODEL=sonnet
AGENT_TIMEOUT_SEC=900
